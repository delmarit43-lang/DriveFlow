generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  STAFF
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum VehicleStatus {
  AVAILABLE
  BOOKED
  RENTED
  MAINTENANCE
}

enum BookingStatus {
  PENDING
  ACTIVE
  COMPLETED
  OVERDUE
  CANCELLED
}

enum PaymentStatus {
  SUCCESS
  PENDING
  FAILED
  REFUNDED
}

enum CustomerTier {
  STANDARD
  GOLD
  PLATINUM
  VIP
}

enum CustomerStatus {
  ACTIVE
  PENDING
  INACTIVE
}

enum DriverAvailability {
  AVAILABLE
  ON_TRIP
  OFF_DUTY
}

enum InvoiceStatus {
  PAID
  PENDING
  OVERDUE
}

enum MaintenanceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum NotificationCategory {
  MAINTENANCE
  BOOKING
  PAYMENT
  VEHICLE
  SYSTEM
}

model User {
  id           String     @id @default(cuid())
  fullName     String
  email        String     @unique
  phone        String     @default("")
  password     String
  profileImage String     @default("")
  role         UserRole   @default(STAFF)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  refreshTokens       RefreshToken[]
  roles               UserRoleAssignment[]
  notifications       Notification[]
  reports             Report[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRoleAssignment[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_role_assignments")
}

model Vehicle {
  id                  String        @id @default(cuid())
  brand               String
  model               String
  name                String
  plate               String        @unique
  category            String
  status              VehicleStatus @default(AVAILABLE)
  fuel                String
  engine              String        @default("")
  transmission        String
  dailyRate           Decimal       @db.Decimal(12, 2)
  image               String        @default("")
  year                Int
  mileage             Int           @default(0)
  seats               Int           @default(5)
  location            String        @default("")
  health              Int           @default(100)
  nextServiceDue      String        @default("")
  insuranceExpiry     String        @default("")
  registrationExpiry  String        @default("")
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  bookings     Booking[]
  drivers      Driver[]
  maintenance  Maintenance[]
  payments     Payment[]

  @@index([status])
  @@map("vehicles")
}

model Customer {
  id              String         @id @default(cuid())
  name            String
  email           String
  phone           String         @default("")
  address         String         @default("")
  license         String         @default("")
  licenseExpiry   String         @default("")
  tier            CustomerTier   @default(STANDARD)
  status          CustomerStatus @default(ACTIVE)
  avatar          String         @default("")
  memberSince     Int            @default(2026)
  totalRentals    Int            @default(0)
  lifetimeSpend   Decimal        @default(0) @db.Decimal(14, 2)
  loyaltyProgress Int            @default(0)
  balance         Decimal        @default(0) @db.Decimal(14, 2)
  trips           Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  bookings  Booking[]
  payments  Payment[]
  invoices  Invoice[]

  @@index([email])
  @@map("customers")
}

model Booking {
  id             String        @id @default(cuid())
  customerId     String
  vehicleId      String
  status         BookingStatus @default(PENDING)
  pickup         String
  returnDate     String
  pickupLocation String        @default("")
  amount         Decimal       @default(0) @db.Decimal(14, 2)
  paymentStatus  PaymentStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicle  Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  payments Payment[]
  invoices Invoice[]

  @@index([customerId])
  @@index([vehicleId])
  @@index([status])
  @@map("bookings")
}

model Driver {
  id                    String             @id @default(cuid())
  name                  String
  email                 String             @unique
  phone                 String             @default("")
  avatar                String             @default("")
  license               String             @default("")
  licenseExpiry         String             @default("")
  rating                Float              @default(5)
  trips                 Int                @default(0)
  performance           Int                @default(80)
  availability          DriverAvailability @default(AVAILABLE)
  assignedVehicleId     String?
  emergencyContactName  String             @default("")
  emergencyContactPhone String             @default("")
  documents             Json?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  assignedVehicle Vehicle? @relation(fields: [assignedVehicleId], references: [id], onDelete: SetNull)

  @@map("drivers")
}

model Payment {
  id         String        @id @default(cuid())
  bookingId  String?
  customerId String?
  vehicleId  String?
  amount     Decimal       @db.Decimal(14, 2)
  method     String        @default("")
  status     PaymentStatus @default(PENDING)
  paidAt     DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  booking  Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  vehicle  Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("payments")
}

model Invoice {
  id         String        @id @default(cuid())
  bookingId  String?
  customerId String?
  amount     Decimal       @db.Decimal(14, 2)
  issuedAt   DateTime      @default(now())
  dueAt      DateTime?
  status     InvoiceStatus @default(PENDING)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  booking  Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("invoices")
}

model Maintenance {
  id          String            @id @default(cuid())
  vehicleId   String
  title       String
  description String            @default("")
  cost        Decimal           @default(0) @db.Decimal(14, 2)
  garage      String            @default("")
  priority    String            @default("medium")
  status      MaintenanceStatus @default(PENDING)
  dueDate     String            @default("")
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([status])
  @@map("maintenance")
}

model Report {
  id          String   @id @default(cuid())
  title       String
  type        String   @default("")
  payload     Json?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@map("reports")
}

model Notification {
  id          String               @id @default(cuid())
  userId      String?
  category    NotificationCategory @default(SYSTEM)
  title       String
  description String               @default("")
  read        Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([read])
  @@map("notifications")
}

model PaymentMethod {
  id        String   @id @default(cuid())
  type      String   @default("visa")
  label     String
  detail    String
  meta      String   @default("")
  isDefault Boolean  @default(false)
  verified  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payment_methods")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}
