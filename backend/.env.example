# Server
PORT=3002
NODE_ENV=development

# Public app URL (password-reset links)
APP_URL=http://127.0.0.1:5173

# Comma-separated browser origins allowed to call the API
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL — local OR cloud (Neon / Supabase / RDS)
# Local Docker: postgresql://postgres:postgres@127.0.0.1:5432/driveflow
# Neon example: postgresql://USER:PASS@ep-xxxx.region.aws.neon.tech/driveflow?sslmode=require
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/driveflow

# JWT secrets — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters each
JWT_ACCESS_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_64_CHAR_RANDOM_HEX
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Behind nginx/Caddy/load balancer
TRUST_PROXY=false

# Optional SMTP (if omitted, reset links are logged to the server console)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=DriveFlow <noreply@yourdomain.com>
