# Copy to .env for docker compose (never commit real secrets)
POSTGRES_PASSWORD=change-me-db-password
JWT_ACCESS_SECRET=generate-with-openssl-rand-hex-48
JWT_REFRESH_SECRET=generate-another-openssl-rand-hex-48
CORS_ORIGIN=http://localhost:3002,http://127.0.0.1:3002
APP_URL=http://127.0.0.1:3002
# Leave empty when UI is served by the same Node process
VITE_API_URL=
TRUST_PROXY=true
# DOMAIN=yourdomain.com
